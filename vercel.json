{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "main.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "env": {
    "FORECAST_WORKERS": "0"
  }
}

{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "FORECAST_WORKERS": "0"
  },
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

# Copy to .env and fill in. .env is gitignored; never commit a real key.
OPENWEATHER_API_KEY=your_API_key_here
# Only for scripts/fetch_dem.py: a free key from myOpenTopo at opentopography.org
OPENTOPOGRAPHY_API_KEY=your_API_key_here
# Which DEM the flood model reads: GEDTM30, COP30 (downloads in app/data/dem) or tiles.
# Unset, a bare-earth download is used if there is one.
# DEM_SOURCE=GEDTM30
# Restart the development server when code changes: 1 to turn on.
# RELOAD=1
